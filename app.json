{
  "expo": {
    "name": "AgileCoachIQ",
    "slug": "AgileIQ",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "agilecoachiq",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0F172A",
    "description": "AI-powered Agile and Scrum coaching. Get expert guidance on Scrum, SAFe, Kanban, and Agile best practices — anytime, anywhere.",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.agilecoachiq.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.agilecoachiq.app",
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "AgileCoachIQ needs access to your photos to analyze project boards and roadmaps.",
          "cameraPermission": "AgileCoachIQ needs camera access to photograph your Agile boards for analysis."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1D9E75",
          "iosDisplayInForeground": true
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "353f26f8-036d-4679-901b-656c7ea38e48"
      }
    },
    "owner": "azchad"
  }
}
